    "tauri:build": "cargo build --release --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@wasifyai/client": "workspace:*",
    "@wasifyai/ui": "workspace:*",
    "lucide-react": "1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^2.1.0"
  }
