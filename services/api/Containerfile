FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock* ./
COPY services ./services
COPY packages ./packages
COPY products ./products
RUN uv sync --frozen --no-dev --package wasifyai-api --package wasifyai-music --package wasifyai-image --package wasifyai-video --package wasifyai-tts --package wasifyai-stt --package wasifyai-lipsync || uv sync --no-dev --package wasifyai-api --package wasifyai-music --package wasifyai-image --package wasifyai-video --package wasifyai-tts --package wasifyai-stt --package wasifyai-lipsync
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "wasifyai_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
