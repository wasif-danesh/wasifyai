FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
# ffmpeg: the video product joins and normalises clips (Extend video) and the voice product converts recordings
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock* ./
COPY services ./services
COPY packages ./packages
COPY products ./products
RUN uv sync --frozen --no-dev --package wasifyai-api --package wasifyai-image --package wasifyai-video --package wasifyai-assistant --package wasifyai-notebooks --package wasifyai-voice --package wasifyai-model3d || uv sync --no-dev --package wasifyai-api --package wasifyai-image --package wasifyai-video --package wasifyai-assistant --package wasifyai-notebooks --package wasifyai-voice --package wasifyai-model3d
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "wasifyai_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
