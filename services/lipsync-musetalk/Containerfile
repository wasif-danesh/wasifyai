# The lip sync server (ADR-0044): MuseTalk v1.5 behind POST /v1/lipsync.
# CPU by default (what a laptop cluster has); for a CUDA host build with
#   --build-arg BASE=pytorch/pytorch:2.7.0-cuda12.6-cudnn9-runtime --build-arg TORCH_INDEX=
# and run with LIPSYNC_DEVICE=cuda. The model files are fetched on first start into the volume at
# /opt/musetalk/models, never baked into the image. Build from the repository root:
#   podman build -f services/lipsync-musetalk/Containerfile -t wasifyai/lipsync-musetalk .
ARG BASE=python:3.11-slim
FROM ${BASE}
ARG MUSETALK_COMMIT=0a89dec
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
RUN apt-get update && apt-get install -y --no-install-recommends git libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
RUN git clone -q https://github.com/TMElyralab/MuseTalk.git /opt/musetalk \
    && cd /opt/musetalk && git checkout -q ${MUSETALK_COMMIT}
WORKDIR /app
COPY services/lipsync-musetalk/requirements.txt .
# torch first, from the index that matches the hardware; the rest of the requirements then see it installed
RUN if [ -n "${TORCH_INDEX}" ]; then pip install --no-cache-dir torch torchvision torchaudio --index-url ${TORCH_INDEX}; fi \
    && pip install --no-cache-dir -r requirements.txt
COPY services/lipsync-musetalk/engine.py services/lipsync-musetalk/server.py services/lipsync-musetalk/fetch_models.py ./
ENV MUSETALK_DIR=/opt/musetalk \
    LIPSYNC_DEVICE=cpu \
    TORCH_HOME=/opt/musetalk/models/torch \
    HF_HUB_DISABLE_XET=1 \
    TORCHDYNAMO_DISABLE=1 \
    PYTHONUNBUFFERED=1
EXPOSE 8000
# Fetch the models (once), then serve: the pod is not ready until the server is up.
CMD ["sh", "-c", "python fetch_models.py /opt/musetalk && exec python -m uvicorn server:app --host 0.0.0.0 --port 8000"]
